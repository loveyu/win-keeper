import { Button, ScrollView, TextEdit } from "std-widgets.slint";

export struct ToolRow {
    name: string,
    status: string,
    memory: string,
    accent: color,
    pid: int,
    manager: bool,
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 38px;
    border-radius: 8px;
    opacity: enabled ? 1 : 0.45;
    background: !enabled ? #172a3b : touch.pressed ? (primary ? #cf722b : #14283a) : primary ? #ed8b3a : touch.has-hover ? #263f56 : #1d3348;
    border-width: primary ? 0px : 1px;
    border-color: #38556b;
    Text {
        text: root.label;
        color: primary ? #102638 : #e6edf2;
        font-family: "Trebuchet MS";
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component RefreshButton inherits Rectangle {
    in property <bool> busy: false;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: busy ? #172a3b : touch.pressed ? #cf722b : touch.has-hover ? #263f56 : #1d3348;
    border-width: 1px;
    border-color: #38556b;
    Text {
        text: root.busy ? "..." : "↻";
        color: root.busy ? #7894a5 : #e6edf2;
        font-size: root.busy ? 10px : 18px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: !root.busy; clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    in property <bool> chinese: false;
    title: chinese ? "WinKeeper — 进程控制台" : "WinKeeper — Process Console";
    icon: @image-url("tray-icon.png");
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 880px;
    min-height: 560px;
    background: #0d2132;
    default-font-family: "Trebuchet MS";

    in property <[ToolRow]> tools;
    in-out property <int> selected-index: -1;
    in property <string> log-text;
    in property <string> summary;
    in property <string> config-path;
    in property <bool> memory-refreshing: false;

    callback start-tool(int);
    callback stop-tool(int);
    callback restart-tool(int);
    callback start-all;
    callback stop-all;
    callback restart-all;
    callback refresh-memory;
    callback open-log-file(int);
    callback open-workdir(int);
    callback hide-requested;
    callback exit-requested;

    Rectangle {
        background: #0d2132;

        VerticalLayout {
            padding: 26px;
            spacing: 18px;

            HorizontalLayout {
                height: 68px;
                spacing: 16px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "WINKEEPER"; color: #ed8b3a; font-size: 13px; font-weight: 800; letter-spacing: 2px; }
                    Text { text: root.chinese ? "进程控制台" : "Process Console"; color: #f1f4f5; font-size: 29px; font-weight: 700; }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                VerticalLayout {
                    alignment: center;
                    Text { text: root.summary; color: #a9bcc8; font-size: 13px; horizontal-alignment: right; }
                    Text { text: root.config-path; color: #6f8b9c; font-size: 11px; horizontal-alignment: right; overflow: elide; }
                }
            }

            HorizontalLayout {
                spacing: 16px;
                vertical-stretch: 1;

                Rectangle {
                    width: 56%;
                    background: #10283a;
                    border-width: 1px;
                    border-color: #29465a;
                    border-radius: 12px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        HorizontalLayout {
                            height: 30px;
                            Text { text: root.chinese ? "工具" : "TOOL"; color: #7894a5; font-size: 11px; font-weight: 700; horizontal-stretch: 1; }
                            Text { text: root.chinese ? "状态" : "STATUS"; color: #7894a5; font-size: 11px; font-weight: 700; width: 96px; }
                            HorizontalLayout {
                                width: 104px;
                                spacing: 5px;
                                Text { text: root.chinese ? "内存" : "MEMORY"; color: #7894a5; font-size: 11px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                RefreshButton { busy: root.memory-refreshing; clicked => { root.refresh-memory(); } }
                            }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 6px;
                                for row[i] in root.tools : Rectangle {
                                    height: 54px;
                                    border-radius: 8px;
                                    background: root.selected-index == i ? #24465c : row-touch.has-hover ? #19374b : #142e41;
                                    border-width: root.selected-index == i ? 1px : 0px;
                                    border-color: row.accent;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 10px;
                                        Rectangle { width: 5px; height: 28px; border-radius: 3px; background: row.accent; }
                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: row.name; color: #edf2f4; font-size: 14px; font-weight: 600; overflow: elide; }
                                            Text { text: row.pid > 0 ? "PID " + row.pid : root.chinese ? "无活动进程" : "No active process"; color: #718c9d; font-size: 10px; }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: row.status; color: row.accent; font-size: 12px; font-weight: 700; width: 96px; vertical-alignment: center; }
                                        Text { text: row.memory; color: #c4d0d7; font-size: 12px; width: 104px; vertical-alignment: center; }
                                    }
                                    row-touch := TouchArea { clicked => { root.selected-index = i; } }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: #091b29;
                    border-width: 1px;
                    border-color: #29465a;
                    border-radius: 12px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        HorizontalLayout {
                            height: 30px;
                            Text { text: root.chinese ? "实时输出" : "LIVE OUTPUT"; color: #ed8b3a; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.selected-index >= 0 ? root.chinese ? "已缓存" : "BUFFERED" : root.chinese ? "空闲" : "IDLE"; color: #6f8b9c; font-size: 10px; }
                        }
                        TextEdit {
                            vertical-stretch: 1;
                            text: root.log-text;
                            read-only: true;
                            font-family: "Consolas";
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            ActionButton { label: root.chinese ? "打开日志" : "Open log"; clicked => { root.open-log-file(root.selected-index); } }
                            ActionButton { label: root.chinese ? "工作目录" : "Work dir"; clicked => { root.open-workdir(root.selected-index); } }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 40px;
                spacing: 9px;
                ActionButton { width: 82px; label: root.chinese ? "启动" : "Start"; primary: true; clicked => { root.start-tool(root.selected-index); } }
                ActionButton { width: 82px; label: root.chinese ? "停止" : "Stop"; clicked => { root.stop-tool(root.selected-index); } }
                ActionButton { width: 90px; label: root.chinese ? "重启" : "Restart"; clicked => { root.restart-tool(root.selected-index); } }
                Rectangle { width: 1px; height: 28px; background: #365065; }
                ActionButton { width: 94px; label: root.chinese ? "全部启动" : "Start all"; clicked => { root.start-all(); } }
                ActionButton { width: 94px; label: root.chinese ? "全部停止" : "Stop all"; clicked => { root.stop-all(); } }
                ActionButton { width: 104px; label: root.chinese ? "全部重启" : "Restart all"; clicked => { root.restart-all(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                ActionButton { width: 72px; label: root.chinese ? "隐藏" : "Hide"; clicked => { root.hide-requested(); } }
                ActionButton { width: 66px; label: root.chinese ? "退出" : "Exit"; clicked => { root.exit-requested(); } }
            }
        }
    }
}

export component KeeperTray inherits SystemTrayIcon {
    in property <bool> chinese: false;
    icon: @image-url("tray-icon.png");
    title: "WinKeeper";
    tooltip: chinese ? "WinKeeper 进程守护工具" : "WinKeeper process supervisor";
    visible: true;

    callback open-manager;
    callback start-all;
    callback stop-all;
    callback restart-all;
    callback open-config;
    callback exit-requested;

    clicked => { root.open-manager(); }
    Menu {
        MenuItem { title: root.chinese ? "打开管理器" : "Open Manager"; activated => { root.open-manager(); } }
        MenuSeparator {}
        MenuItem { title: root.chinese ? "全部启动" : "Start All"; activated => { root.start-all(); } }
        MenuItem { title: root.chinese ? "全部停止" : "Stop All"; activated => { root.stop-all(); } }
        MenuItem { title: root.chinese ? "全部重启" : "Restart All"; activated => { root.restart-all(); } }
        MenuSeparator {}
        MenuItem { title: root.chinese ? "打开配置文件" : "Open Config File"; activated => { root.open-config(); } }
        MenuItem { title: root.chinese ? "退出 WinKeeper" : "Exit WinKeeper"; activated => { root.exit-requested(); } }
    }
}
