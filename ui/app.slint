import { Button, ScrollView, TextEdit } from "std-widgets.slint";

export struct ToolRow {
    name: string,
    status: string,
    memory: string,
    accent: color,
    pid: int,
    restart-count: int,
    manager: bool,
    state: int,
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 38px;
    border-radius: 8px;
    background: !enabled ? #172a3b : touch.pressed ? (primary ? #cf722b : #14283a) : primary ? #ed8b3a : touch.has-hover ? #263f56 : #1d3348;
    border-width: primary ? 0px : 1px;
    border-color: enabled ? #38556b : #2b4354;
    Text {
        text: root.label;
        color: !root.enabled ? #718c9d : primary ? #102638 : #e6edf2;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component RefreshButton inherits Rectangle {
    in property <bool> busy: false;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: busy ? #172a3b : touch.pressed ? #cf722b : touch.has-hover ? #263f56 : #1d3348;
    border-width: 1px;
    border-color: #38556b;
    Text {
        text: root.busy ? "..." : "↻";
        color: root.busy ? #7894a5 : #e6edf2;
        font-size: root.busy ? 10px : 18px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: !root.busy; clicked => { root.clicked(); } }
}

component InspectButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    width: 44px;
    height: 28px;
    border-radius: 7px;
    background: !enabled ? #172a3b : touch.pressed ? #cf722b : touch.has-hover ? #31526b : #1d3b52;
    border-width: 1px;
    border-color: enabled ? #42647b : #2b4354;
    Text {
        text: root.label;
        color: root.enabled ? #dce7ec : #718c9d;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    in property <bool> chinese: false;
    in property <string> ui-font-family;
    in property <string> code-font-family;
    title: chinese ? "WinKeeper — 进程控制台" : "WinKeeper — Process Console";
    icon: @image-url("tray-icon.png");
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 880px;
    min-height: 560px;
    background: #0d2132;
    default-font-family: root.ui-font-family;

    in property <[ToolRow]> tools;
    in-out property <int> selected-index: -1;
    in property <string> log-text;
    in property <string> output-timing;
    in property <string> app-version;
    in property <string> summary;
    in property <string> config-path;
    in property <bool> memory-refreshing: false;
    in property <bool> can-start-all: false;
    in property <bool> can-stop-all: false;
    in property <bool> can-restart-all: false;
    in-out property <bool> process-tree-visible: false;
    in-out property <bool> process-tree-loading: false;
    in property <string> process-tree-title;
    in property <string> process-tree-text;

    callback start-tool(int);
    callback stop-tool(int);
    callback restart-tool(int);
    callback start-all;
    callback stop-all;
    callback restart-all;
    callback refresh-memory;
    callback select-tool(int);
    callback open-log-file(int);
    callback open-workdir(int);
    callback inspect-process(int);
    callback open-config;
    callback hide-requested;
    callback exit-requested;

    private property <bool> valid-selection: root.selected-index >= 0 && root.selected-index < root.tools.length;
    private property <bool> selected-manager: root.valid-selection && root.tools[root.selected-index].manager;
    private property <int> selected-state: root.valid-selection ? root.tools[root.selected-index].state : -1;
    private property <bool> can-start-selected: root.valid-selection && !root.selected-manager && (root.selected-state == 0 || root.selected-state == 5);
    private property <bool> can-stop-selected: root.valid-selection && !root.selected-manager && (root.selected-state == 1 || root.selected-state == 2 || root.selected-state == 4);
    private property <bool> can-restart-selected: root.valid-selection && !root.selected-manager && root.selected-state == 2;

    Rectangle {
        background: #0d2132;

        VerticalLayout {
            padding: 26px;
            spacing: 18px;

            HorizontalLayout {
                height: 68px;
                spacing: 16px;
                VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        height: 18px;
                        spacing: 8px;
                        Text { text: "WINKEEPER"; color: #ed8b3a; font-size: 13px; font-weight: 800; letter-spacing: 2px; vertical-alignment: center; }
                        Text { text: root.app-version; color: #6f8b9c; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Text { text: root.chinese ? "进程控制台" : "Process Console"; color: #f1f4f5; font-size: 29px; font-weight: 700; }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                VerticalLayout {
                    alignment: center;
                    Text { text: root.summary; color: #a9bcc8; font-size: 13px; horizontal-alignment: right; }
                    Rectangle {
                        height: 22px;
                        background: config-touch.has-hover ? #19374b : transparent;
                        border-radius: 5px;
                        Text {
                            text: root.config-path;
                            color: config-touch.has-hover ? #9fb9c8 : #6f8b9c;
                            font-size: 11px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        config-touch := TouchArea { clicked => { root.open-config(); } }
                    }
                }
            }

            HorizontalLayout {
                spacing: 16px;
                vertical-stretch: 1;

                Rectangle {
                    width: 56%;
                    background: #10283a;
                    border-width: 1px;
                    border-color: #29465a;
                    border-radius: 12px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        HorizontalLayout {
                            height: 30px;
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 10px;
                            Rectangle { width: 5px; background: transparent; }
                            Text { text: root.chinese ? "工具" : "TOOL"; color: #7894a5; font-size: 11px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: root.chinese ? "状态" : "STATUS"; color: #7894a5; font-size: 11px; font-weight: 700; width: 96px; vertical-alignment: center; }
                            Text { text: root.chinese ? "内存" : "MEMORY"; color: #7894a5; font-size: 11px; font-weight: 700; width: 104px; vertical-alignment: center; }
                            Rectangle {
                                width: 48px;
                                height: 30px;
                                background: transparent;
                                RefreshButton { x: 11px; y: 2px; busy: root.memory-refreshing; clicked => { root.refresh-memory(); } }
                            }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 6px;
                                for row[i] in root.tools : Rectangle {
                                    height: 54px;
                                    border-radius: 8px;
                                    background: root.selected-index == i ? #24465c : row-touch.has-hover ? #19374b : #142e41;
                                    border-width: root.selected-index == i ? 1px : 0px;
                                    border-color: row.accent;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 10px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            background: transparent;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Rectangle { width: 5px; height: 28px; border-radius: 3px; background: row.accent; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text { text: row.name; color: #edf2f4; font-size: 14px; font-weight: 600; overflow: elide; }
                                                    Text {
                                                        text: row.pid > 0
                                                            ? "PID " + row.pid + (row.restart-count > 0 ? (root.chinese ? "  ·  重启 " : "  ·  Restarts ") + row.restart-count : "")
                                                            : root.chinese ? "无活动进程" : "No active process";
                                                        color: #718c9d;
                                                        font-size: 10px;
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                                Text { text: row.status; color: row.accent; font-size: 12px; font-weight: 700; width: 96px; vertical-alignment: center; }
                                                Text { text: row.memory; color: #c4d0d7; font-size: 12px; width: 104px; vertical-alignment: center; }
                                            }
                                            row-touch := TouchArea { clicked => { root.select-tool(i); } }
                                        }
                                        Rectangle {
                                            width: 48px;
                                            height: 54px;
                                            background: transparent;
                                            InspectButton {
                                                x: 2px;
                                                y: 13px;
                                                label: root.chinese ? "进程树" : "Tree";
                                                enabled: row.pid > 0;
                                                clicked => {
                                                    root.select-tool(i);
                                                    root.inspect-process(i);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: #091b29;
                    border-width: 1px;
                    border-color: #29465a;
                    border-radius: 12px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            Text {
                                text: root.chinese ? "实时输出" : "LIVE OUTPUT";
                                color: #ed8b3a;
                                font-size: 11px;
                                font-weight: 800;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.output-timing;
                                color: #7894a5;
                                font-size: 10px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.selected-index >= 0 ? root.chinese ? "已缓存" : "BUFFERED" : root.chinese ? "空闲" : "IDLE"; color: #6f8b9c; font-size: 10px; }
                        }
                        TextEdit {
                            vertical-stretch: 1;
                            text: root.log-text;
                            read-only: true;
                            font-family: root.code-font-family;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            ActionButton { label: root.chinese ? "打开日志" : "Open log"; enabled: root.valid-selection; clicked => { root.open-log-file(root.selected-index); } }
                            ActionButton { label: root.chinese ? "工作目录" : "Work dir"; enabled: root.valid-selection; clicked => { root.open-workdir(root.selected-index); } }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 40px;
                spacing: 9px;
                ActionButton { width: 82px; label: root.chinese ? "启动" : "Start"; primary: true; enabled: root.can-start-selected; clicked => { root.start-tool(root.selected-index); } }
                ActionButton { width: 82px; label: root.chinese ? "停止" : "Stop"; enabled: root.can-stop-selected; clicked => { root.stop-tool(root.selected-index); } }
                ActionButton { width: 90px; label: root.chinese ? "重启" : "Restart"; enabled: root.can-restart-selected; clicked => { root.restart-tool(root.selected-index); } }
                Rectangle { width: 1px; height: 28px; background: #365065; }
                ActionButton { width: 94px; label: root.chinese ? "全部启动" : "Start all"; enabled: root.can-start-all; clicked => { root.start-all(); } }
                ActionButton { width: 94px; label: root.chinese ? "全部停止" : "Stop all"; enabled: root.can-stop-all; clicked => { root.stop-all(); } }
                ActionButton { width: 104px; label: root.chinese ? "全部重启" : "Restart all"; enabled: root.can-restart-all; clicked => { root.restart-all(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                ActionButton { width: 72px; label: root.chinese ? "隐藏" : "Hide"; clicked => { root.hide-requested(); } }
                ActionButton { width: 66px; label: root.chinese ? "退出" : "Exit"; clicked => { root.exit-requested(); } }
            }
        }
    }

    if root.process-tree-visible : Rectangle {
        background: #06131dcc;
        backdrop-touch := TouchArea { clicked => { root.process-tree-visible = false; } }
        dialog := Rectangle {
            width: root.width < 900px ? root.width - 60px : 820px;
            height: root.height < 640px ? root.height - 60px : 560px;
            x: (root.width - dialog.width) / 2;
            y: (root.height - dialog.height) / 2;
            background: #10283a;
            border-width: 1px;
            border-color: #42647b;
            border-radius: 14px;
            panel-touch := TouchArea {}
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    height: 40px;
                    Text { text: root.process-tree-title; color: #f1f4f5; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 88px; label: root.chinese ? "关闭" : "Close"; clicked => { root.process-tree-visible = false; } }
                }
                if root.process-tree-loading : Rectangle {
                    vertical-stretch: 1;
                    background: #0b2030;
                    border-radius: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        Text {
                            text: "…";
                            color: #ed8b3a;
                            font-size: 36px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.chinese ? "正在读取进程信息…" : "Loading process information…";
                            color: #a9bcc8;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                    }
                }
                if !root.process-tree-loading : TextEdit {
                    vertical-stretch: 1;
                    text: root.process-tree-text;
                    read-only: true;
                    font-family: root.code-font-family;
                    font-size: 12px;
                    wrap: no-wrap;
                }
            }
        }
    }
}

export component KeeperTray inherits SystemTrayIcon {
    in property <bool> chinese: false;
    icon: @image-url("tray-icon.png");
    title: "WinKeeper";
    tooltip: chinese ? "WinKeeper 进程守护工具" : "WinKeeper process supervisor";
    visible: true;

    callback open-manager;
    callback start-all;
    callback stop-all;
    callback restart-all;
    callback open-config;
    callback exit-requested;

    clicked => { root.open-manager(); }
    Menu {
        MenuItem { title: root.chinese ? "打开管理器" : "Open Manager"; activated => { root.open-manager(); } }
        MenuSeparator {}
        MenuItem { title: root.chinese ? "全部启动" : "Start All"; activated => { root.start-all(); } }
        MenuItem { title: root.chinese ? "全部停止" : "Stop All"; activated => { root.stop-all(); } }
        MenuItem { title: root.chinese ? "全部重启" : "Restart All"; activated => { root.restart-all(); } }
        MenuSeparator {}
        MenuItem { title: root.chinese ? "打开配置文件" : "Open Config File"; activated => { root.open-config(); } }
        MenuItem { title: root.chinese ? "退出 WinKeeper" : "Exit WinKeeper"; activated => { root.exit-requested(); } }
    }
}
